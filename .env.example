# Copy to .env and fill in values.
# Backend loads this file automatically on startup.

# Path to the Ultralytics YOLO segmentation checkpoint (relative to project root)
YOLO_MODEL_PATH=best (2).pt

# Optional inference tuning
YOLO_CONF=0.25
YOLO_IOU=0.45

# Gemini Q&A (leave blank until ready — /qa will return a deterministic fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# CORS origins for the Vite frontend
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
