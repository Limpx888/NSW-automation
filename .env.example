# Copy to .env and fill in values.
# Backend loads this file automatically on startup.

# Path to the Ultralytics YOLO segmentation checkpoint (relative to project root)
YOLO_MODEL_PATH=backend/weights/best.pt

# Optional inference tuning
YOLO_CONF=0.25
YOLO_IOU=0.45

# Gemini Q&A (leave blank until ready — /qa will return a deterministic fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# CORS origins for the Vite frontend
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# Supabase Auth Configuration
VITE_SUPABASE_URL=https://rkrddqnfszcgrlyxsmna.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_sDAUVytFmkVWg-K8-u_cCw_r_hF4cZ8

# ── Cloud Knowledge Base (Supabase + pgvector) ────────────────────────────────
# REQUIRED for cloud RAG features.  Get these from Supabase Dashboard → Settings → API
# Use the Service Role key (not anon) so the backend can insert rows.
SUPABASE_URL=https://rkrddqnfszcgrlyxsmna.supabase.co
SUPABASE_SERVICE_KEY=

# PostgreSQL connection string (use postgresql+psycopg:// for psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
