{
  "version": "1.0",
  "title": "AI Dispensing Defect Detective — cause ranking rules",
  "notes": "Ranking is deterministic. An LLM may explain fired rules but must not change weights. Solder-paste baselines are Type 4; powder factors rescale clog/oxidation/spread. Weights in each baseline sum to 100.",
  "sources": [
    "https://nswautomation.com/NSW/micro-dispensing-application-solutions/",
    "https://nswautomation.com/NSW/prevent-solder-paste-dispensing-clog/",
    "https://www.aimsolder.com/white-paper/solder-paste-powder-when-to-downsize/",
    "IPC J-STD-005A particle size classification (via AIM)",
    "NPL Dispensing Code of Practice (stringing/satellites)",
    "Indium / Nordson needle ID vs powder type guidance"
  ],
  "defect_classes": [
    "under_dispense",
    "over_dispense",
    "missing",
    "inconsistent_volume",
    "spreading",
    "air_bubble_irregular"
  ],
  "materials": ["solder_paste", "silver_epoxy", "uv_glue", "silicone_gel"],
  "patterns": ["dot", "line", "dam_fill"],
  "powder_types": {
    "T3": {
      "d_min_um": 25,
      "d_max_um": 45,
      "nsw_min_nozzle_um": 225,
      "sa_v_ratio_vs_t4": 0.64,
      "clog_factor": 0.7,
      "oxidation_factor": 0.55,
      "spread_factor": 1.15,
      "typical_use": "Larger SMT (0603/0805). Forgiving. NSW prefers T5+ for micro-dispensing."
    },
    "T4": {
      "d_min_um": 20,
      "d_max_um": 38,
      "nsw_min_nozzle_um": 190,
      "sa_v_ratio_vs_t4": 1.0,
      "clog_factor": 1.0,
      "oxidation_factor": 1.0,
      "spread_factor": 1.0,
      "typical_use": "0201s, 0.5 mm BGA — current SMT standard."
    },
    "T5": {
      "d_min_um": 15,
      "d_max_um": 25,
      "nsw_min_nozzle_um": 125,
      "sa_v_ratio_vs_t4": 1.45,
      "clog_factor": 1.3,
      "oxidation_factor": 1.35,
      "spread_factor": 0.8,
      "typical_use": "01005s, ultra-fine pitch. NSW recommended starting type for general dispensing."
    },
    "T6": {
      "d_min_um": 5,
      "d_max_um": 15,
      "nsw_min_nozzle_um": 80,
      "sa_v_ratio_vs_t4": 2.9,
      "clog_factor": 1.7,
      "oxidation_factor": 1.85,
      "spread_factor": 0.6,
      "typical_use": "microLED, chip-scale, SiP. NSW: 80 µm dots with T6. Highest clog and oxidation risk."
    }
  },
  "five_x_rule": {
    "statement": "Nozzle inner diameter should be at least 5x the largest powder particle diameter.",
    "source": "NSW Automation clog-prevention guide; AIM 5-ball rule adapted from stencil to nozzle ID.",
    "conservative_industry": "Some needle vendors use 7x powder size (Nordson/Indium).",
    "t6_vs_t4_copy": "Type 6 powder has ~3x the surface-area-to-volume ratio of Type 4, so it oxidizes and agglomerates faster."
  },
  "causes": {
    "nozzle_partial_clog": {
      "name": "Partial nozzle / valve clog",
      "category": "Nozzle",
      "cost_rank": 2,
      "check": "Inspect the nozzle under magnification; purge or replace the tip; clean with the recommended solvent (NSW: IPA ultrasonic for paste nozzles).",
      "materials": ["solder_paste", "silver_epoxy", "uv_glue", "silicone_gel"]
    },
    "powder_nozzle_mismatch": {
      "name": "Nozzle ID vs powder size (5x rule)",
      "category": "Material-process match",
      "cost_rank": 3,
      "check": "Confirm paste type (T3-T6) and nozzle ID. NSW: ID >= 5x largest particle (T5 >= 125 um, T6 >= 80 um).",
      "materials": ["solder_paste"]
    },
    "powder_oxidation": {
      "name": "Powder oxidation / agglomeration",
      "category": "Material",
      "cost_rank": 4,
      "check": "Check paste age, fridge-to-floor warmup, and whether T5/T6 was left open. Finer powder oxidizes faster.",
      "materials": ["solder_paste"]
    },
    "flux_metal_separation": {
      "name": "Flux / metal separation in the syringe",
      "category": "Material",
      "cost_rank": 2,
      "check": "NSW: store syringe tip-down; use dispensing-grade paste; keep pressure low so flux does not separate from powder.",
      "materials": ["solder_paste"]
    },
    "air_trapped_syringe": {
      "name": "Air trapped in syringe or fluid path",
      "category": "Material supply",
      "cost_rank": 1,
      "check": "Look for bubbles in the syringe, piston tunneling, or a pocket of air under a stopped piston. Purge until a solid bead appears.",
      "materials": ["solder_paste", "silver_epoxy", "uv_glue", "silicone_gel"]
    },
    "pressure_time_low": {
      "name": "Pressure or dispense time too low / unstable",
      "category": "Parameters",
      "cost_rank": 2,
      "check": "Verify pressure and on-time against the last known-good recipe. Look for regulator drift.",
      "materials": ["solder_paste", "silver_epoxy", "uv_glue", "silicone_gel"]
    },
    "pressure_time_high": {
      "name": "Pressure or dispense time too high",
      "category": "Parameters",
      "cost_rank": 2,
      "check": "Reduce pressure/time. NSW: high pressure separates paste and causes clogs; UV/silicone will flood the pad.",
      "materials": ["solder_paste", "silver_epoxy", "uv_glue", "silicone_gel"]
    },
    "z_gap_wrong": {
      "name": "Z-gap (nozzle-to-board) out of window",
      "category": "Process",
      "cost_rank": 3,
      "check": "NSW: too low traps particles in the tip (clog); too high and the fluid does not wet the surface (tall peaks, stringing, missing).",
      "materials": ["solder_paste", "silver_epoxy", "uv_glue", "silicone_gel"]
    },
    "material_storage_expired": {
      "name": "Expired, warm, or poorly stored material",
      "category": "Material",
      "cost_rank": 2,
      "check": "Check expiry, storage temperature (NSW paste: cool room <15 C unless vendor says otherwise), and time out of fridge.",
      "materials": ["solder_paste", "silver_epoxy", "uv_glue", "silicone_gel"]
    },
    "viscosity_temp_humidity": {
      "name": "Viscosity shift from temperature / humidity",
      "category": "Environment",
      "cost_rank": 3,
      "check": "Log booth temperature and humidity. Paste and silicone thin when warm; UV glue flow is strongly viscosity-driven.",
      "materials": ["solder_paste", "silver_epoxy", "uv_glue", "silicone_gel"]
    },
    "equipment_wear": {
      "name": "Valve, pump, or regulator wear",
      "category": "Equipment",
      "cost_rank": 5,
      "check": "Last check after cheaper items. Look for inconsistent shot weight on a scale, leaking seals, or a drifting regulator.",
      "materials": ["solder_paste", "silver_epoxy", "uv_glue", "silicone_gel"]
    },
    "substrate_contamination": {
      "name": "Substrate contamination or poor wetting",
      "category": "Board",
      "cost_rank": 3,
      "check": "Inspect the local pad/cavity for flux residue, mold release, fingerprints, or uneven topography. More likely if the defect is in one location.",
      "materials": ["solder_paste", "silver_epoxy", "uv_glue", "silicone_gel"]
    },
    "stringing_satellites": {
      "name": "Stringing / satellites on needle retract",
      "category": "Process",
      "cost_rank": 3,
      "check": "Increase retract height so the bead snaps before the head moves (NPL dispensing code). Do not treat this as stencil smear.",
      "materials": ["solder_paste", "silver_epoxy", "uv_glue", "silicone_gel"]
    },
    "piston_suckback": {
      "name": "Piston mismatch or excessive vacuum suck-back",
      "category": "Hardware setup",
      "cost_rank": 3,
      "check": "Excess suck-back pulls air into the syringe (Dymax). Never fill a syringe more than ~2/3 full. Match piston type to viscosity.",
      "materials": ["solder_paste", "silver_epoxy", "uv_glue", "silicone_gel"]
    },
    "filler_settling": {
      "name": "Silver filler settling / mix inconsistency",
      "category": "Material",
      "cost_rank": 2,
      "check": "Remix or replace the syringe per vendor instructions. Settled silver looks like clogging and inconsistent volume.",
      "materials": ["silver_epoxy"]
    },
    "premature_uv_cure": {
      "name": "Premature UV cure in barrel or tip",
      "category": "Material-process match",
      "cost_rank": 2,
      "check": "Use opaque/amber UV-blocking barrels and tips. Replace plastic tips if adhesive has gelled. Watch pressure rise as a clog signal.",
      "materials": ["uv_glue"]
    },
    "uv_process_window": {
      "name": "UV lamp intensity or cure-time window",
      "category": "Cure",
      "cost_rank": 4,
      "check": "Confirm lamp intensity and exposure time. Under-cure leaves wet spread; stray light gels the tip.",
      "materials": ["uv_glue"]
    },
    "dam_flow_geometry": {
      "name": "Dam path, speed, or substrate temperature",
      "category": "Process",
      "cost_rank": 3,
      "check": "Slow the dam path, check gel temperature, and confirm dam height before fill. Collapse and voids are geometry/flow, not powder size.",
      "materials": ["silicone_gel", "uv_glue"]
    }
  },
