  "pattern_multipliers": {
    "dot": {},
    "line": {
      "stringing_satellites": 1.15,
      "z_gap_wrong": 1.1
    },
    "dam_fill": {
      "dam_flow_geometry": 1.45,
      "substrate_contamination": 1.15,
      "viscosity_temp_humidity": 1.15,
      "powder_nozzle_mismatch": 0.75
    }
  },
  "adjustment_rules": [
    {
      "id": "occasional_points_to_air",
      "when": {"frequency": "occasional"},
      "multiply": {
        "air_trapped_syringe": 1.8,
        "piston_suckback": 1.35,
        "nozzle_partial_clog": 0.75,
        "equipment_wear": 0.8,
        "powder_nozzle_mismatch": 0.85
      },
      "explain": "Volume that comes and goes is classic trapped air or tunneling, not a steadily clogging nozzle."
    },
    {
      "id": "continuous_points_to_clog_or_drift",
      "when": {"frequency": "continuous"},
      "multiply": {
        "nozzle_partial_clog": 1.45,
        "powder_nozzle_mismatch": 1.3,
        "viscosity_temp_humidity": 1.25,
        "premature_uv_cure": 1.25,
        "filler_settling": 1.2,
        "air_trapped_syringe": 0.7
      },
      "explain": "A defect that never recovers is more likely a clog, wrong nozzle/powder pair, or a viscosity/cure drift than a random bubble."
    },
    {
      "id": "recent_nozzle_change",
      "when": {"recent_change": "nozzle"},
      "multiply": {
        "nozzle_partial_clog": 1.4,
        "powder_nozzle_mismatch": 1.7,
        "z_gap_wrong": 1.3,
        "premature_uv_cure": 1.2
      },
      "explain": "A just-changed nozzle is the first place to apply the NSW 5x ID rule and re-check Z-gap."
    },
    {
      "id": "recent_material_change",
      "when": {"recent_change": "material"},
      "multiply": {
        "material_storage_expired": 1.5,
        "powder_oxidation": 1.4,
        "powder_nozzle_mismatch": 1.35,
        "viscosity_temp_humidity": 1.3,
        "filler_settling": 1.5,
        "premature_uv_cure": 1.3,
        "flux_metal_separation": 1.25
      },
      "explain": "New or swapped material changes particle size, filler load, or UV sensitivity. Re-validate nozzle pairing and storage."
    },
    {
      "id": "recent_settings_change",
      "when": {"recent_change": "settings"},
      "multiply": {
        "pressure_time_low": 1.45,
        "pressure_time_high": 1.45,
        "z_gap_wrong": 1.2,
        "piston_suckback": 1.2
      },
      "explain": "If pressure, time, or suck-back was just edited, parameter error outranks material ageing."
    },
    {
      "id": "single_location",
      "when": {"location": "single"},
      "multiply": {
        "z_gap_wrong": 1.4,
        "substrate_contamination": 1.5,
        "nozzle_partial_clog": 1.1,
        "viscosity_temp_humidity": 0.75,
        "material_storage_expired": 0.8
      },
      "explain": "One site implicates local Z-height, a dirty pad, or a path-specific skip — not a whole-syringe material problem."
    },
    {
      "id": "multi_location",
      "when": {"location": "multiple"},
      "multiply": {
        "viscosity_temp_humidity": 1.3,
        "material_storage_expired": 1.25,
        "powder_oxidation": 1.25,
        "pressure_time_low": 1.15,
        "pressure_time_high": 1.15,
        "filler_settling": 1.25,
        "premature_uv_cure": 1.2,
        "substrate_contamination": 0.7
      },
      "explain": "The same defect across many sites is systemic: material, environment, or machine parameters."
    },
    {
      "id": "after_runtime_warmup",
      "when": {"timing": "after_runtime"},
      "multiply": {
        "premature_uv_cure": 1.7,
        "nozzle_partial_clog": 1.3,
        "powder_oxidation": 1.2,
        "viscosity_temp_humidity": 1.25,
        "filler_settling": 1.2
      },
      "explain": "Starts good, then fails: UV glue gelling in the tip, paste drying/oxidizing, or viscosity climbing as the valve warms."
    },
    {
      "id": "clear_uv_barrel",
      "when": {"uv_barrel": "clear"},
      "multiply": {
        "premature_uv_cure": 1.9,
        "nozzle_partial_clog": 1.25
      },
      "explain": "Clear barrels and tips let stray light gel UV adhesive in the fluid path — a common, avoidable clog."
    },
    {
      "id": "epoxy_not_mixed",
      "when": {"mix_state": "no"},
      "multiply": {
        "filler_settling": 1.8,
        "nozzle_partial_clog": 1.2
      },
      "explain": "Unmixed silver epoxy lets filler settle, which looks like random volume and then a sudden clog."
    }
  ],
  "downstream_warnings": {
    "over_dispense": ["bridging"],
    "spreading": ["bridging"],
    "under_dispense": ["tombstoning", "open_joint"],
    "inconsistent_volume": ["tombstoning"],
    "air_bubble_irregular": ["voiding", "satellites"],
    "missing": ["open_joint"]
  },
  "discovery_questions": [
    {
      "id": "material",
      "prompt": "What material is being dispensed?",
      "options": ["solder_paste", "silver_epoxy", "uv_glue", "silicone_gel"]
    },
    {
      "id": "pattern",
      "prompt": "What pattern is being dispensed?",
      "options": ["dot", "line", "dam_fill"]
    },
    {
      "id": "amount",
      "prompt": "Is the dispensed amount too small, too large, missing, inconsistent, spreading, or irregular/bubbly?",
      "options": ["too_small", "too_large", "missing", "inconsistent", "spreading", "irregular"],
      "maps_to_defect": {
        "too_small": "under_dispense",
        "too_large": "over_dispense",
        "missing": "missing",
        "inconsistent": "inconsistent_volume",
        "spreading": "spreading",
        "irregular": "air_bubble_irregular"
      }
    },
    {
      "id": "frequency",
      "prompt": "Is the defect happening continuously or only occasionally?",
      "options": ["continuous", "occasional"]
    },
    {
      "id": "recent_change",
      "prompt": "Has the material, nozzle, or process setting recently changed?",
      "options": ["none", "material", "nozzle", "settings"]
    },
    {
      "id": "location",
      "prompt": "Is the defect happening at one location or across multiple locations?",
      "options": ["single", "multiple"]
    }
  ],
  "followups": {
    "solder_paste": [
      {
        "id": "powder_type",
        "prompt": "Which solder powder type is in the syringe?",
        "options": ["T3", "T4", "T5", "T6", "unknown"]
      },
      {
        "id": "nozzle_id_um",
        "prompt": "Optional: nozzle inner diameter in micrometres (NSW 5x check).",
        "options": "number_or_skip"
      }
    ],
    "uv_glue": [
      {
        "id": "uv_barrel",
        "prompt": "Are the syringe and tip UV-blocking (amber/black), or clear?",
        "options": ["blocking", "clear", "unknown"]
      },
      {
        "id": "timing",
        "prompt": "Does it start good and fail after the machine has been running?",
        "options": ["immediate", "after_runtime", "unknown"]
      }
    ],
    "silicone_gel": [
      {
        "id": "timing",
        "prompt": "Does flow change after the line has been running (temperature drift)?",
        "options": ["immediate", "after_runtime", "unknown"]
      }
    ],
    "silver_epoxy": [
      {
        "id": "mix_state",
        "prompt": "Was the silver epoxy freshly mixed / syringe rolled before loading?",
        "options": ["yes", "no", "unknown"]
      }
    ]
  }
}
