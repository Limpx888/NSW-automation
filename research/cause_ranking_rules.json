  "mechanisms": {
    "air_trapped_syringe": "trapped air pockets passing through the nozzle tip and interrupting the shot",
    "piston_suckback": "vacuum suck-back pulling air into the syringe between shots",
    "nozzle_partial_clog": "a partially blocked or damaged nozzle that meters less fluid, often with stringing or a bent path",
    "powder_nozzle_mismatch": "powder particles too large for the nozzle ID (NSW 5\u00d7 rule), so the tip packs off over time",
    "viscosity_temp_humidity": "bulk viscosity shifting with booth temperature or humidity, moving every shot in the same direction",
    "pressure_time_low": "air pressure or on-time drifting below the known-good recipe",
    "pressure_time_high": "air pressure or on-time drifting above the known-good recipe",
    "equipment_wear": "valve, pump, or axis wear that shows up as alignment decay or unstable shot weight",
    "premature_uv_cure": "UV adhesive gelling in a clear barrel or tip",
    "z_gap_wrong": "nozzle-to-board gap out of window, so the bead does not wet or is smeared"
  },
