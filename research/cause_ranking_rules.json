  "pattern_multipliers": {
    "dot": {},
    "line": {
      "stringing_satellites": 1.15,
      "z_gap_wrong": 1.1
    },
    "dam_fill": {
      "dam_flow_geometry": 1.45,
      "substrate_contamination": 1.15,
      "viscosity_temp_humidity": 1.15,
      "powder_nozzle_mismatch": 0.75
    }
  },
  "adjustment_rules": [
    {
      "id": "occasional_points_to_air",
      "when": {
        "frequency": "occasional"
      },
      "multiply": {
        "air_trapped_syringe": 1.8,
        "piston_suckback": 1.35,
        "nozzle_partial_clog": 0.75,
        "equipment_wear": 0.8,
        "powder_nozzle_mismatch": 0.85
      },
      "explain": "Volume that comes and goes is classic trapped air or tunneling, not a steadily clogging nozzle."
    },
    {
      "id": "continuous_points_to_clog_or_drift",
      "when": {
        "frequency": "continuous"
      },
      "multiply": {
        "nozzle_partial_clog": 1.45,
        "powder_nozzle_mismatch": 1.3,
        "viscosity_temp_humidity": 1.25,
        "premature_uv_cure": 1.25,
        "filler_settling": 1.2,
        "air_trapped_syringe": 0.7
      },
      "explain": "A defect that never recovers is more likely a clog, wrong nozzle/powder pair, or a viscosity/cure drift than a random bubble."
    },
    {
      "id": "recent_nozzle_change",
      "when": {
        "recent_change": "nozzle"
      },
      "multiply": {
        "nozzle_partial_clog": 1.4,
        "powder_nozzle_mismatch": 1.7,
        "z_gap_wrong": 1.3,
        "premature_uv_cure": 1.2
      },
      "explain": "A just-changed nozzle is the first place to apply the NSW 5x ID rule and re-check Z-gap."
    },
    {
      "id": "recent_material_change",
      "when": {
        "recent_change": "material"
      },
      "multiply": {
        "material_storage_expired": 1.5,
        "powder_oxidation": 1.4,
        "powder_nozzle_mismatch": 1.35,
        "viscosity_temp_humidity": 1.3,
        "filler_settling": 1.5,
        "premature_uv_cure": 1.3,
        "flux_metal_separation": 1.25
      },
      "explain": "New or swapped material changes particle size, filler load, or UV sensitivity. Re-validate nozzle pairing and storage."
    },
    {
      "id": "recent_settings_change",
      "when": {
        "recent_change": "settings"
      },
      "multiply": {
        "pressure_time_low": 1.45,
        "pressure_time_high": 1.45,
        "z_gap_wrong": 1.2,
        "piston_suckback": 1.2
      },
      "explain": "If pressure, time, or suck-back was just edited, parameter error outranks material ageing."
    },
    {
      "id": "single_location",
      "when": {
        "location": "single"
      },
      "multiply": {
        "z_gap_wrong": 1.4,
        "substrate_contamination": 1.5,
        "nozzle_partial_clog": 1.1,
        "viscosity_temp_humidity": 0.75,
        "material_storage_expired": 0.8
      },
      "explain": "One site implicates local Z-height, a dirty pad, or a path-specific skip \u2014 not a whole-syringe material problem."
    },
    {
      "id": "multi_location",
      "when": {
        "location": "multiple"
      },
      "multiply": {
        "viscosity_temp_humidity": 1.3,
        "material_storage_expired": 1.25,
        "powder_oxidation": 1.25,
        "pressure_time_low": 1.15,
        "pressure_time_high": 1.15,
        "filler_settling": 1.25,
        "premature_uv_cure": 1.2,
        "substrate_contamination": 0.7
      },
      "explain": "The same defect across many sites is systemic: material, environment, or machine parameters."
    },
    {
      "id": "after_runtime_warmup",
      "when": {
        "timing": "after_runtime"
      },
      "multiply": {
        "premature_uv_cure": 1.7,
        "nozzle_partial_clog": 1.3,
        "powder_oxidation": 1.2,
        "viscosity_temp_humidity": 1.25,
        "filler_settling": 1.2
      },
      "explain": "Starts good, then fails: UV glue gelling in the tip, paste drying/oxidizing, or viscosity climbing as the valve warms."
    },
    {
      "id": "after_restart_air",
      "when": {
        "timing": "after_restart"
      },
      "multiply": {
        "air_trapped_syringe": 1.75,
        "piston_suckback": 1.45,
        "nozzle_partial_clog": 0.8
      },
      "explain": "A defect that appears right after restart often means air that settled in the syringe or a vacuum pocket from suck-back, not a clog that grew during the run."
    },
    {
